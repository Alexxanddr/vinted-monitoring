# Copy to .env and configure locally. Never commit real values.
VM_HTTP_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Both Telegram variables must be set together; omit both for search-only use.
# VM_TELEGRAM_TOKEN=
# VM_TELEGRAM_CHAT_ID=
VM_ALLOWED_HOSTS='["127.0.0.1:*","localhost:*","vinted-monitoring:8000"]'
